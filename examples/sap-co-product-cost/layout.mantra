;; Presentation choices only: table order, columns, labels, number formats and class styles.
(layout sap.co/product-cost-paper
  {:preset :ifrs-schedule
   :title "Manufacturing cost collection and product unit cost"
   :subtitle "Primary and secondary cost elements · actual versus standard"
   :precision 2
   :header [:subject :period :schema :prepared-by :reference]}

  (style {:all true} {:fill :none})
  (style {:class :variance} {:weight :bold :tone :accent :fill :subtle})
  (style {:section product-costs :class :variance :column :member} {:fill :accent})

  (columns :matrix
    (col :label {:header "Cost flow"})
    (col :cross-total {:width 14})
    (col :status {:width 3}))

  (table cost-sources {:title "1 · Cost element collection" :style :tiered})
  (table order-costs {:title "2 · Manufacturing orders" :style :matrix}
    (col :label {:header "Order cost"})
    (members order)
    :cross-total
    :status)
  (table product-costs {:title "3 · Weighted product costs" :style :matrix}
    (col :label {:header "Product cost"})
    (members product)
    :cross-total
    :status)
  (table reconciliation {:title "4 · Reconciliation" :style :tiered}))
