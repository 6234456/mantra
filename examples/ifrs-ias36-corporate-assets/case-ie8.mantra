;; Facts of IAS 36 Illustrative Example 8 (IE69–IE79): entity M with CGUs A, B and C,
;; a headquarters building (allocable) and a research centre (not allocable).
(case ias36-ie8
  {:schema "ifrs.ias36/corporate-assets"
   :title "Entity M – corporate assets"
   :subject "Entity M"
   :period "End of 20X0"
   :prepared-by "Mantra acceptance example"
   :reference "IAS 36 IE69–IE79"}
  (inputs
    {:cgus [{:id :A :name "A" :carrying-amount 100 :remaining-life 10 :value-in-use 199}
            {:id :B :name "B" :carrying-amount 150 :remaining-life 20 :value-in-use 164}
            {:id :C :name "C" :carrying-amount 200 :remaining-life 20 :value-in-use 271}]
     :allocable-corporate 150
     :unallocable-corporate 50
     :group-recoverable-amount 720}))
