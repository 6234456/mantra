;; Fictional already-deducted expenses from frozen trade/unsupported-entity.json.
(case unsupported-entity
  {:schema "de.gewst/2025" :schema-version "2025.1" :layout "de.gewst/2025-working-paper"
   :parameters ["de.gewst/2025-parameters"] :title "Gewerbesteuer 2025: unsupported-entity"
   :expected-business [{:code "MANTRA-CHECK-FAILED" :node "entity-supported" :severity :error}]}
  (inputs {:profit 120000 :hebesatz-percent 400
           :entity :corporation :section9-deductions 0
           :financing-costs [{:id :F1 :category :debt :amount 150000}
                             {:id :F2 :category :movable-rent :amount 100000}
                             {:id :F3 :category :immovable-rent :amount 100000}
                             {:id :F4 :category :licence :amount 40000}]}))
