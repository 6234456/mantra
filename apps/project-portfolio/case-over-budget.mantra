     :projects [
      {:id :A :title "Fictional tooling upgrade" :department-id :DELIVERY :cost 80 :benefit 140 :hours 70 :selected true :approval-note "Fictional selection A"}
      {:id :B :title "Fictional service refresh" :department-id :DELIVERY :cost 50 :benefit 75 :hours 50 :selected true :approval-note "Fictional selection B"}
      {:id :C :title "Fictional prototype" :department-id :RESEARCH :cost 40 :benefit 68 :hours 60 :selected true :approval-note "Fictional selection C"}
     ]}))
