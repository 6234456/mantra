;; Independently authored fictional inputs for the Mantra demonstration.
;; Amounts, useful lives and labels are not a reproduction of an IFRS illustrative example.
(case ias36-custom-weight
  {:schema "ifrs.ias36/corporate-assets"
   :layout "ifrs.ias36/working-paper"
   :title "Fictional custom asset weighting"
   :subject "Demo Facilities Ltd"
   :period "2025-12-31"
   :prepared-by "Mantra acceptance demonstration"
   :reference "Project-authored fictional data"}
  (inputs
    {:cgus [{:id :A :name "North" :carrying-amount 120 :remaining-life 6 :value-in-use 180}
            {:id :B :name "Central" :carrying-amount 180 :remaining-life 12 :value-in-use 210}
            {:id :C :name "South" :carrying-amount 260 :remaining-life 18 :value-in-use 300}]
     :allocable-corporate 211
     :unallocable-corporate 73
     :group-recoverable-amount 900})
  (bind weighting (* remaining-life remaining-life)))
