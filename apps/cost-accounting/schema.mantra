;; Synthetic SAP CO-style product costing example. The schema is domain content; the engine only
;; provides generic table, dimension, allocation, totaling and rendering primitives.
(schema cost.accounting/product-cost
  {:title "Product cost by manufacturing order"
   :subtitle "Primary cost elements, secondary allocations, order costs and product weighted averages"
   :version "0.1"
   :preset :ifrs-schedule
   :headline total-variance
   :group-titles {:source-data "Source data"}
   :mainline [cost-sources order-costs product-costs reconciliation]}

  ;; Primary postings include direct order debits and pooled expense accounts. Secondary postings
  ;; represent internal activity allocation and overhead assessment to be assigned by a cost driver.
  (input primary-postings :table
    {:label "Primary cost element postings" :group :source-data
     :columns {:cost-element :text :expense-account :text :mode :keyword
               :order-id :keyword? :amount :decimal}
     :references {:order-id order}})
  (input secondary-postings :table
    {:label "Secondary cost element postings"
     :columns {:cost-element :text :source-cost-center :text :amount :decimal}})
  (input orders :table
    {:label "Manufacturing orders"
     :columns {:id :keyword :name :text :product-id :keyword :quantity :decimal
               :allocation-base :decimal :standard-unit-cost :decimal}})
  (input products :table
    {:label "Products"
     :columns {:id :keyword :name :text}})
  (param allocation-scale 2 {:label "Currency precision for cost allocation"})
  (param unit-scale 4 {:label "Precision of unit-cost comparison"})

  (dimension order {:label "Manufacturing order" :from orders :key :id :title :name
                    :parent product :parent-key :product-id})
  (dimension product {:label "Product" :from products :key :id :title :name})

  ;; Expense accounts / cost elements are facts. The application decides which postings are direct
  ;; and which form a pool; this logic remains outside the generic engine.
  (section cost-sources "Cost element collection" {:display :schedule}
    (line direct-primary-total "Primary costs posted directly to orders"
      (sum (map (fn [posting] (if (= posting.mode :direct) posting.amount 0)) primary-postings)))
    (line primary-pool "Primary expense accounts to allocate"
      (sum (map (fn [posting] (if (= posting.mode :pool) posting.amount 0)) primary-postings)))
    (line secondary-pool "Secondary cost elements to allocate"
      (sum (map (fn [posting] posting.amount) secondary-postings)))
    (total source-cost-total "Total actual costs to assign"))

  ;; The same allocation base is applied to both pools. Direct primary costs retain their original
  ;; order attribution; pooled primary and secondary costs are separately visible in the audit trail.
  (section order-costs "Actual and standard cost by manufacturing order" {:per order :display :schedule}
    (line allocation-base "Allocation base" order.allocation-base {:op :info :format :number})
    (line direct-primary "Direct primary cost elements"
      (sum (map (fn [posting]
                  (if (and (= posting.mode :direct) (= posting.order-id order.key)) posting.amount 0))
                primary-postings)))
    (line primary-allocated "Allocated primary expense accounts"
      (alloc/pro-rata primary-pool all.allocation-base allocation-scale) {:spread true})
    (line secondary-allocated "Allocated secondary cost elements"
      (alloc/pro-rata secondary-pool all.allocation-base allocation-scale) {:spread true})
    (total actual-order-cost "Actual order cost")
    (line produced-quantity "Completed quantity" order.quantity {:op :info :format :number})
    (line actual-order-unit-cost "Actual cost per completed unit"
      (decimal/divide actual-order-cost produced-quantity unit-scale)
      {:op :info :format :number :precision 4 :aggregate false})
    (line standard-order-unit-cost "Standard cost per unit" order.standard-unit-cost
      {:op :info :format :number :precision 4 :aggregate false})
    (line standard-order-cost "Standard cost for completed quantity"
      (* produced-quantity standard-order-unit-cost) {:op :info})
    (line order-variance "Actual less standard cost" (- actual-order-cost standard-order-cost) {:op :info}))

  ;; Product unit costs are quantity-weighted averages of the underlying orders, calculated as
  ;; total cost / total completed quantity for each product.
  (section product-costs "Quantity-weighted product costs" {:per product :display :schedule}
    (line product-quantity "Completed quantity"
      (dim/rollup all.produced-quantity relation_order product.key)
      {:op :info :format :number})
    (line product-actual-cost "Actual cost of product orders"
      (dim/rollup all.actual-order-cost relation_order product.key))
    (total product-cost-total "Total actual product cost")
    (line product-standard-cost "Standard cost of product orders"
      (dim/rollup all.standard-order-cost relation_order product.key) {:op :info})
    (line actual-weighted-unit "Weighted average actual unit cost"
      (decimal/divide product-actual-cost product-quantity unit-scale)
      {:op :info :format :number :precision 4 :aggregate false})
    (line standard-weighted-unit "Weighted average standard unit cost"
      (decimal/divide product-standard-cost product-quantity unit-scale)
      {:op :info :format :number :precision 4 :aggregate false})
    (line product-variance "Actual less standard cost"
      (- product-actual-cost product-standard-cost) {:op :info :class :variance}))

  (section reconciliation "Cost flow reconciliation" {:display :schedule}
    (line all-order-cost "Actual cost assigned to orders" (dim/sum all.actual-order-cost))
    (line all-product-cost "Actual cost aggregated to products" (dim/sum all.product-actual-cost)
      {:op :info})
    (line unassigned-cost "Source costs less assigned order costs"
      (- source-cost-total all-order-cost) {:op :info})
    (line product-crossfoot "Order costs less product costs"
      (- all-order-cost all-product-cost) {:op :info})
    (line all-standard-cost "Standard cost for completed output" (dim/sum all.product-standard-cost)
      {:op :info})
    (line total-variance "Actual less standard cost"
      (- all-product-cost all-standard-cost)
      {:op :info :sign-labels {:positive "Unfavourable variance" :negative "Favourable variance" :zero "No variance"}})))

;; Simplification: direct costs and pools do not overlap; secondary upstream costs are not counted twice.
;; Simplification: standards and completed quantities are supplied; no WIP, posting or settlement.
