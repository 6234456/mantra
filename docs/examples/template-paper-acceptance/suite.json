    {
      "document": "layout.mantra",
      "role": "layout",
      "sha256": "080ea9e19770fa535373884f7a39995ef7fc5dd34c3fd8ce1f8aecfd3711ddb8",
      "text": "(layout example/template-paper-acceptance-layout\n  {:title \"Candidate paper\" :locale \"de-DE\" :precision 3 :hide-zero true :zero \"ZERO\"}\n  (style-class :custom {:weight :bold :tone :accent :fill :subtle})\n  (style {:class :custom} {:use [:custom]})\n  (table main (col :label {:header \"Item\"}) (col :value {:header \"Amount\"}))\n  (table matrix {:style :matrix :row-dimension entity}\n    :label (col :first {:content (member year :Y1) :header \"Y1\"})\n    (col :second {:content (member year :Y2) :header \"Y2\"}) :cross-total))\n"
    },
    {
      "document": "schema.mantra",
      "role": "schema",
      "sha256": "217248d7c2aa77bf06213a9dd5e593c9a0dd83da874cb1fd3d5260ffd362d9a1",
      "text": "; Independent arithmetic: candidate answer = base-amount * 3; each matrix cell = 7.\n(schema example/template-paper-acceptance {:version \"1\" :mainline [main]}\n  (input base-amount :decimal)\n  (dimension entity {:members [:A :B]})\n  (dimension year {:members [:Y1 :Y2]})\n  (section main \"Summary\" {:panel true}\n    (info answer \"Answer\" (* base-amount 3) {:class :custom})\n    (info zero-row \"Zero\" 0))\n  (section matrix \"Matrix\" {:panel true :per [entity year]}\n    (info element \"Element\" 7 {:aggregate :sum})))\n"
    }
  ],
