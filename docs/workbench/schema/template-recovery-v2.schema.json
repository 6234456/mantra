{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mantra.local/workbench/schema/template-recovery-v2.schema.json",
  "title": "Unvalidated real template preview source recovery with schema property fields",
  "description": "A source-only portable backup, not an HTTP envelope. Runtime validation additionally rejects duplicate JSON keys, nesting deeper than 16, total UTF-8 JSON above 2 MiB, and duplicate identities. Draft strings remain opaque and are not bounded by the preview source limit.",
  "type": "object",
  "required": [
    "format",
    "savedAt",
    "workspaceId",
    "caseId",
    "baseRevision",
    "baseRevisions",
    "documents",
    "inputs",
    "pending"
  ],
  "properties": {
    "format": {
      "const": "mantra.template-preview-recovery/2"
    },
    "savedAt": {
      "type": "string",
      "format": "date-time"
    },
    "workspaceId": {
      "$ref": "#/$defs/hash"
    },
    "caseId": {
      "type": "string",
      "minLength": 1
    },
    "baseRevision": {
      "$ref": "#/$defs/hash"
    },
    "baseRevisions": {
      "$ref": "template-sources.schema.json#/$defs/sourceRevisions",
      "minProperties": 1
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/document"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "role": {
                "const": "schema"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "role": {
                "const": "layout"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        }
      ]
    },
    "inputs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "pending": {
      "type": "object",
      "required": [
        "layoutSettings",
        "styleClass"
      ],
      "properties": {
        "layoutSettings": {
          "type": "array",
          "maxItems": 14,
          "items": {
            "$ref": "#/$defs/layoutOperation"
          }
        },
        "styleClass": {
          "anyOf": [
            {
              "$ref": "#/$defs/styleDraft"
            },
            {
              "type": "null"
            }
          ]
        },
        "schemaProperty": {
          "anyOf": [
            {
              "$ref": "#/$defs/schemaPropertyDraft"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "document": {
      "type": "object",
      "required": [
        "handle",
        "document",
        "role",
        "sha256",
        "baseText",
        "text"
      ],
      "properties": {
        "handle": {
          "$ref": "#/$defs/hash"
        },
        "document": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "schema",
            "layout"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "baseText": {
          "type": "string",
          "maxLength": 65536
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": [
        "node",
        "text"
      ],
      "properties": {
        "node": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "layoutOperation": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "op",
            "property",
            "text"
          ],
          "properties": {
            "op": {
              "const": "set"
            },
            "property": {
              "$ref": "template-layout-settings.schema.json#/$defs/propertyId"
            },
            "text": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "op",
            "property"
          ],
          "properties": {
            "op": {
              "const": "unset"
            },
            "property": {
              "$ref": "template-layout-settings.schema.json#/$defs/propertyId"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "styleOperation": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "op",
            "name",
            "style"
          ],
          "properties": {
            "op": {
              "const": "upsert"
            },
            "name": {
              "type": "string"
            },
            "style": {
              "$ref": "template-style-classes.schema.json#/$defs/styleSpec"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "op",
            "name"
          ],
          "properties": {
            "op": {
              "const": "remove"
            },
            "name": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "styleDraft": {
      "type": "object",
      "required": [
        "operation",
        "creating",
        "selection"
      ],
      "properties": {
        "operation": {
          "$ref": "#/$defs/styleOperation"
        },
        "creating": {
          "type": "boolean"
        },
        "selection": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "schemaPropertyDraft": {
      "type": "object",
      "required": [
        "document",
        "path",
        "form",
        "node",
        "property",
        "declaration",
        "text",
        "unset"
      ],
      "properties": {
        "document": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "form": {
          "type": "string",
          "minLength": 1
        },
        "node": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "property": {
          "enum": [
            "label",
            "text",
            "classes"
          ]
        },
        "declaration": {
          "type": "string",
          "maxLength": 65536
        },
        "text": {
          "type": "string"
        },
        "unset": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "unset": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "property": {
                "const": "classes"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
