{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mantra.local/workbench/schema/envelope.schema.json",
  "title": "Mantra workbench response v4",
  "type": "object",
  "required": [
    "contract",
    "revision",
    "engine",
    "data"
  ],
  "properties": {
    "contract": {
      "const": "mantra.workbench/4"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}([0-9a-f]{48})?$"
    },
    "engine": {
      "type": "object",
      "required": [
        "mantra",
        "normein"
      ],
      "properties": {
        "mantra": {
          "type": "string"
        },
        "normein": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "data": {}
  },
  "additionalProperties": false,
  "$defs": {
    "address": {
      "type": "object",
      "required": [
        "node",
        "case"
      ],
      "properties": {
        "node": {
          "type": "string"
        },
        "coord": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cell": {
          "type": "object",
          "required": [
            "row",
            "column"
          ],
          "properties": {
            "row": {
              "type": "string"
            },
            "column": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "case": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "required": [
        "document",
        "line",
        "column"
      ],
      "properties": {
        "document": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "startOffset": {
          "type": "integer",
          "minimum": 0
        },
        "endOffset": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "severity",
        "code",
        "message",
        "location",
        "address",
        "related",
        "category",
        "rowIndex",
        "column",
        "caseRevision"
      ],
      "properties": {
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "location": {
          "oneOf": [
            {
              "$ref": "#/$defs/location"
            },
            {
              "type": "null"
            }
          ]
        },
        "address": {
          "oneOf": [
            {
              "$ref": "#/$defs/address"
            },
            {
              "type": "null"
            }
          ]
        },
        "related": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/location"
          }
        },
        "category": {
          "enum": [
            "parsing",
            "structural",
            "evaluation",
            "business"
          ]
        },
        "rowIndex": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "column": {
          "type": [
            "string",
            "null"
          ]
        },
        "caseRevision": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "required": [
        "weight",
        "tone",
        "fill"
      ],
      "properties": {
        "weight": {
          "enum": [
            "normal",
            "bold"
          ]
        },
        "tone": {
          "enum": [
            "default",
            "muted",
            "accent"
          ]
        },
        "fill": {
          "enum": [
            "none",
            "subtle",
            "accent"
          ]
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": [
        "passed",
        "active",
        "severity",
        "reconciliation"
      ],
      "properties": {
        "passed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "active": {
          "type": "boolean"
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        },
        "reconciliation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "left",
                "right",
                "difference",
                "tolerance"
              ],
              "properties": {
                "left": {
                  "$ref": "value.schema.json"
                },
                "right": {
                  "$ref": "value.schema.json"
                },
                "difference": {
                  "$ref": "value.schema.json"
                },
                "tolerance": {
                  "$ref": "value.schema.json"
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ratioAggregate": {
      "type": "object",
      "required": [
        "kind",
        "numeratorId",
        "denominatorId",
        "dimensions",
        "fixed",
        "members",
        "memberCount",
        "activeMemberCount",
        "numeratorTotal",
        "denominatorTotal",
        "rounding",
        "result",
        "undefinedReason",
        "truncated",
        "display"
      ],
      "properties": {
        "kind": {
          "const": "ratio"
        },
        "numeratorId": {
          "type": "string"
        },
        "denominatorId": {
          "type": "string"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fixed": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "members": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "coord",
              "numerator",
              "denominator",
              "active"
            ],
            "properties": {
              "coord": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "numerator": {
                "type": "object",
                "required": [
                  "n"
                ],
                "properties": {
                  "n": {
                    "type": "string",
                    "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
                  }
                },
                "additionalProperties": false
              },
              "denominator": {
                "type": "object",
                "required": [
                  "n"
                ],
                "properties": {
                  "n": {
                    "type": "string",
                    "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
                  }
                },
                "additionalProperties": false
              },
              "active": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "memberCount": {
          "type": "integer",
          "minimum": 0
        },
        "activeMemberCount": {
          "type": "integer",
          "minimum": 0
        },
        "numeratorTotal": {
          "type": "object",
          "required": [
            "n"
          ],
          "properties": {
            "n": {
              "type": "string",
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
            }
          },
          "additionalProperties": false
        },
        "denominatorTotal": {
          "type": "object",
          "required": [
            "n"
          ],
          "properties": {
            "n": {
              "type": "string",
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
            }
          },
          "additionalProperties": false
        },
        "rounding": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "scale",
                "mode"
              ],
              "properties": {
                "scale": {
                  "type": "integer"
                },
                "mode": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "result": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "n"
              ],
              "properties": {
                "n": {
                  "type": "string",
                  "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "undefinedReason": {
          "enum": [
            null,
            "no-active-members",
            "zero-denominator",
            "rounding-required"
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "display": {
          "type": "object",
          "required": [
            "numeratorTotal",
            "denominatorTotal",
            "result"
          ],
          "properties": {
            "numeratorTotal": {
              "type": "string"
            },
            "denominatorTotal": {
              "type": "string"
            },
            "result": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "boundaryAggregate": {
      "type": "object",
      "required": [
        "kind",
        "dimension",
        "boundary",
        "dimensions",
        "fixed",
        "members",
        "memberCount",
        "activeMemberCount",
        "result",
        "undefinedReason",
        "truncated",
        "display",
        "periodKeys",
        "selected",
        "selectionCount"
      ],
      "properties": {
        "kind": {
          "const": "boundary"
        },
        "dimension": {
          "type": "string"
        },
        "boundary": {
          "enum": [
            "first",
            "last"
          ]
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fixed": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "members": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "coord",
              "value",
              "active",
              "selected"
            ],
            "properties": {
              "coord": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "value": {
                "$ref": "value.schema.json"
              },
              "active": {
                "type": "boolean"
              },
              "selected": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "memberCount": {
          "type": "integer",
          "minimum": 0
        },
        "activeMemberCount": {
          "type": "integer",
          "minimum": 0
        },
        "result": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "n"
              ],
              "properties": {
                "n": {
                  "type": "string",
                  "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "undefinedReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "display": {
          "type": "object",
          "required": [
            "result"
          ],
          "properties": {
            "result": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "periodKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "selected": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "coord",
              "value",
              "active",
              "selected"
            ],
            "properties": {
              "coord": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "value": {
                "$ref": "value.schema.json"
              },
              "active": {
                "type": "boolean"
              },
              "selected": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "selectionCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "sumAggregate": {
      "type": "object",
      "required": [
        "kind",
        "dimensions",
        "fixed",
        "members",
        "memberCount",
        "activeMemberCount",
        "result",
        "undefinedReason",
        "truncated",
        "display"
      ],
      "properties": {
        "kind": {
          "const": "sum"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fixed": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "members": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "coord",
              "value",
              "active",
              "selected"
            ],
            "properties": {
              "coord": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "value": {
                "$ref": "value.schema.json"
              },
              "active": {
                "type": "boolean"
              },
              "selected": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "memberCount": {
          "type": "integer",
          "minimum": 0
        },
        "activeMemberCount": {
          "type": "integer",
          "minimum": 0
        },
        "result": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "n"
              ],
              "properties": {
                "n": {
                  "type": "string",
                  "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "undefinedReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "display": {
          "type": "object",
          "required": [
            "result"
          ],
          "properties": {
            "result": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "aggregate": {
      "oneOf": [
        {
          "$ref": "#/$defs/ratioAggregate"
        },
        {
          "$ref": "#/$defs/boundaryAggregate"
        },
        {
          "$ref": "#/$defs/sumAggregate"
        }
      ]
    },
    "schemaIdentity": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "required": [
        "case",
        "path",
        "caseId",
        "schema",
        "revision",
        "address"
      ],
      "properties": {
        "case": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "caseId": {
          "type": "string"
        },
        "schema": {
          "$ref": "#/$defs/schemaIdentity"
        },
        "revision": {
          "type": "string"
        },
        "address": {
          "$ref": "#/$defs/address"
        }
      },
      "additionalProperties": false
    },
    "caseGraph": {
      "type": "object",
      "required": [
        "root",
        "cases",
        "edges"
      ],
      "properties": {
        "root": {
          "type": "string"
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "case",
              "caseId",
              "schema",
              "revision",
              "succeeded",
              "validationPassed"
            ],
            "properties": {
              "case": {
                "type": "string"
              },
              "caseId": {
                "type": "string"
              },
              "schema": {
                "$ref": "#/$defs/schemaIdentity"
              },
              "revision": {
                "type": "string"
              },
              "succeeded": {
                "type": "boolean"
              },
              "validationPassed": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "revision"
            ],
            "properties": {
              "from": {
                "$ref": "#/$defs/address"
              },
              "to": {
                "$ref": "#/$defs/address"
              },
              "revision": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": [
        "counters",
        "limits",
        "reuse"
      ],
      "properties": {
        "counters": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          }
        },
        "reuse": {
          "type": "object",
          "required": [
            "completedTasks",
            "executionSessions"
          ],
          "properties": {
            "completedTasks": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "executionSessions": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "required": [
        "code",
        "kind",
        "stage",
        "counter",
        "limit",
        "attempted",
        "overflow",
        "address"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "counter": {
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempted": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "overflow": {
          "type": "boolean"
        },
        "address": {
          "anyOf": [
            {
              "$ref": "#/$defs/runAddress"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "runAddress": {
      "type": "object",
      "required": [
        "case",
        "node",
        "coord"
      ],
      "properties": {
        "case": {
          "type": [
            "string",
            "null"
          ]
        },
        "node": {
          "type": [
            "string",
            "null"
          ]
        },
        "coord": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
