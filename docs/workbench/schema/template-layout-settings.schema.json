{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mantra.local/workbench/schema/template-layout-settings.schema.json",
  "title": "Root layout settings and sequential source patches",
  "allOf": [{ "$ref": "envelope.schema.json" }],
  "$defs": {
    "propertyId": {
      "enum": ["title", "subtitle", "locale", "language", "precision", "percent-precision", "negative", "zero", "grouping", "hide-zero", "show-inactive", "expand-members", "signed", "row-numbers"]
    },
    "property": {
      "type": "object",
      "required": ["id", "label", "group", "type", "options", "minimum", "maximum", "declared", "explicitValue", "inheritedValue", "effectiveValue", "editable", "reason", "canUnset"],
      "properties": {
        "id": { "$ref": "#/$defs/propertyId" },
        "label": { "type": "string", "minLength": 1 },
        "group": { "enum": ["report", "numbers", "visibility"] },
        "type": { "enum": ["text", "enum", "integer", "boolean"] },
        "options": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "minimum": { "type": ["integer", "null"], "minimum": -9007199254740991, "maximum": 9007199254740991 },
        "maximum": { "type": ["integer", "null"], "minimum": -9007199254740991, "maximum": 9007199254740991 },
        "declared": { "type": "boolean" },
        "explicitValue": { "$ref": "value.schema.json" },
        "inheritedValue": { "$ref": "value.schema.json" },
        "effectiveValue": { "$ref": "value.schema.json" },
        "editable": { "type": "boolean" },
        "reason": { "type": ["string", "null"] },
        "canUnset": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "sourcePatch": {
      "type": "object",
      "required": ["startOffset", "endOffset", "text", "removedText"],
      "properties": {
        "startOffset": { "type": "integer", "minimum": 0, "maximum": 65536 },
        "endOffset": { "type": "integer", "minimum": 0, "maximum": 65536 },
        "text": { "type": "string" },
        "removedText": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "data": {
      "type": "object",
      "required": ["document", "draftSequence", "baseRevisions", "scope", "layoutId", "preset", "source", "properties", "patches"],
      "properties": {
        "document": { "type": "string", "minLength": 1 },
        "draftSequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "baseRevisions": { "$ref": "template-sources.schema.json#/$defs/sourceRevisions" },
        "scope": { "const": "layout" },
        "layoutId": { "type": "string", "minLength": 1 },
        "preset": { "type": "string", "minLength": 1 },
        "source": {
          "type": "object",
          "required": ["handle", "document", "text"],
          "properties": {
            "handle": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "document": { "type": "string", "minLength": 1 },
            "text": { "type": "string", "maxLength": 65536 }
          },
          "additionalProperties": false
        },
        "properties": { "type": "array", "minItems": 14, "maxItems": 14, "items": { "$ref": "#/$defs/property" } },
        "patches": { "type": "array", "items": { "$ref": "#/$defs/sourcePatch" } }
      },
      "additionalProperties": false
    }
  }
}
