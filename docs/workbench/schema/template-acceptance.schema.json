{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mantra.local/workbench/schema/template-acceptance.schema.json",
  "title": "Read-only multi-case template acceptance suite",
  "description": "A standalone CLI format, not an HTTP envelope. Runtime validation additionally enforces valid UTF-8, a 2 MiB byte budget, nesting depth 16, at most 65536 UTF-16 code units for every string and field name, unique document/case/input/assertion/diagnostic identities, and at most 2048 value assertions across the suite. Capture emits null expectations; verification requires independently supplied expectations.",
  "type": "object",
  "required": ["format", "documents", "cases"],
  "properties": {
    "format": { "const": "mantra.template-acceptance/1" },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/document" },
      "allOf": [
        { "contains": { "type": "object", "required": ["role"], "properties": { "role": { "const": "schema" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["role"], "properties": { "role": { "const": "layout" } } }, "minContains": 0, "maxContains": 1 }
      ]
    },
    "cases": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/case" } }
  },
  "additionalProperties": false,
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nonblank": { "type": "string", "minLength": 1, "maxLength": 65536, "pattern": "\\S" },
    "text": { "type": "string", "maxLength": 65536 },
    "revisions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/nonblank" },
      "additionalProperties": { "$ref": "#/$defs/hash" }
    },
    "document": {
      "type": "object",
      "required": ["document", "role", "sha256", "text"],
      "properties": {
        "document": { "$ref": "#/$defs/nonblank" },
        "role": { "enum": ["schema", "layout"] },
        "sha256": { "$ref": "#/$defs/hash" },
        "text": { "$ref": "#/$defs/text" }
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": ["node", "text"],
      "properties": { "node": { "$ref": "#/$defs/nonblank" }, "text": { "$ref": "#/$defs/text" } },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": ["id", "case", "baseRevision", "baseRevisions", "inputs", "expect"],
      "properties": {
        "id": { "$ref": "#/$defs/nonblank", "maxLength": 120 },
        "case": { "$ref": "#/$defs/nonblank" },
        "baseRevision": { "$ref": "#/$defs/hash" },
        "baseRevisions": { "$ref": "#/$defs/revisions" },
        "inputs": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/input" } },
        "panel": { "$ref": "#/$defs/nonblank" },
        "includeZero": { "type": "boolean", "default": false },
        "expect": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/expectation" }] }
      },
      "additionalProperties": false
    },
    "expectation": {
      "type": "object",
      "required": ["succeeded", "validationPassed", "values"],
      "properties": {
        "succeeded": { "type": "boolean" },
        "validationPassed": { "type": "boolean" },
        "values": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/valueAssertion" } },
        "diagnostics": { "type": "array", "maxItems": 2048, "items": { "$ref": "#/$defs/diagnosticGroup" } }
      },
      "additionalProperties": false
    },
    "valueAssertion": {
      "oneOf": [
        {
          "type": "object",
          "required": ["node", "present"],
          "properties": { "node": { "$ref": "#/$defs/nonblank" }, "present": { "const": false } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["node", "present", "value"],
          "properties": {
            "node": { "$ref": "#/$defs/nonblank" },
            "present": { "const": true },
            "value": { "$ref": "value.schema.json" },
            "display": { "$ref": "#/$defs/text" },
            "active": { "type": "boolean" },
            "validationPassed": { "type": ["boolean", "null"] }
          },
          "additionalProperties": false
        }
      ]
    },
    "diagnosticGroup": {
      "type": "object",
      "required": ["code", "severity", "count"],
      "properties": {
        "code": { "$ref": "#/$defs/nonblank" },
        "severity": { "enum": ["error", "warning", "info"] },
        "count": { "type": "integer", "minimum": 1, "maximum": 10000 }
      },
      "additionalProperties": false
    }
  }
}
