  "sourceDocuments": {
    "docs/patterns/actuals-vs-baseline/schema.mantra": {
      "sha256": "352f28bde7a8d22de8598234f1d657243f60a3403bb7c309588fe7582e5a3948",
      "text": "; Fictional quantities, prices and allowances. No classification of a variance as good or bad.\n(schema pattern/actuals-vs-baseline\n  {:title \"Actuals, baseline and remaining allowance\" :version \"1.0.0\"\n   :preset :ifrs-schedule :mainline [comparison] :headline remaining}\n  (include \"../common/formulas.mantra\")\n  (input entries :table\n    {:columns {:id :keyword :title :text :quantity :decimal :actual-price :decimal\n               :baseline-price :decimal :allowance :decimal} :min-rows 1})\n  (input amount-scale :integer {:default 2 :label \"Explicit amount rounding scale\"})\n  (dimension member {:from entries :key :id :title :title :total-label \"All members\"})\n  (section comparison \"Named comparison measures\" {:per member :op :info :panel true}\n    (info supplied-quantity \"Supplied quantity\" member.quantity {:class :source :format :number})\n    (info actual-price \"Supplied actual price\" member.actual-price {:class :source :aggregate false})\n    (info baseline-price \"Supplied baseline price\" member.baseline-price {:class :assumption :aggregate false})\n    (info actual \"Actual amount\"\n      (pattern-rounded-product supplied-quantity actual-price amount-scale) {:class :detail})\n    (info baseline \"Baseline amount\"\n      (pattern-rounded-product supplied-quantity baseline-price amount-scale) {:class :detail})\n    (info variance \"Actual less baseline\" (- actual baseline) {:class :variance})\n    (info allowance \"Supplied allowance\" member.allowance {:class :assumption})\n    (info remaining \"Allowance less actual\" (- allowance actual) {:class [:result :key-result]})\n    (check allowance-fits \"Actual amount is within supplied allowance\" (>= remaining 0) {:class :control})\n    (note \"A signed difference has no implicit favourable or unfavourable interpretation.\" {:class :note})))\n"
    },
    "docs/patterns/common/formulas.mantra": {
      "sha256": "8f8024b05467d7027465bcdb8781822b2b8f184c7ab41770697f547c75468d98",
      "text": "; Pure helpers shared by the pattern workspace. Explicit scale; standard half-up operations.\n; Callers choose applicability, zero-denominator handling and whether a ratio is additive.\n(fragment\n  (defn pattern-rounded-product [^Decimal amount ^Decimal multiplier ^Integer scale]\n    (decimal/round (* amount multiplier) scale))\n  (defn pattern-rounded-ratio [^Decimal numerator ^Decimal denominator ^Integer scale]\n    (decimal/divide numerator denominator scale)))\n"
    },
    "docs/patterns/actuals-vs-baseline/case-demo.mantra": {
      "sha256": "0984f446e3560accf0128defb1ad86571da0e0ee677c8e9b57982599b5f84062",
      "text": "(case pattern/actuals-demo\n  {:schema \"pattern/actuals-vs-baseline\" :schema-version \"1.0.0\"\n   :layout \"pattern/actuals-paper\" :title \"Fictional comparison inputs\"}\n  (inputs {:entries (rows [:id :title :quantity :actual-price :baseline-price :allowance]\n                      [:A \"Member A\" 10 12 10 150]\n                      [:B \"Member B\" 8 10 11.25 100])}))\n"
    },
    "docs/patterns/actuals-vs-baseline/layout.mantra": {
      "sha256": "6d01b416b98e7764c103d5228bd1a160dfae9c87a3029e300b3cfa4d4cd59ab8",
      "text": "(layout pattern/actuals-paper\n  {:schema \"pattern/actuals-vs-baseline\" :schema-version \"1.0.0\"\n   :preset :ifrs-schedule :style-preset [:utilities :working-paper]\n   :title \"Comparison measures\" :precision 2 :hide-zero false}\n  (style-class :key-result {:weight :bold :tone :accent :fill :subtle})\n  (style {:class :result :column :cross-total} {:use [:strong :accent] :fill :subtle})\n  (table comparison {:style :matrix} :label (members member) :cross-total :status))\n"
    }
  },
